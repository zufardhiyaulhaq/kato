# Copy to .env and adjust. `make run` loads this file automatically.
# These map 1:1 to internal/config/config.go.

# Namespace where kato stores Run CRs and reads ModelConfig API-key Secrets.
# For local dev, create it first: kubectl create namespace kato
KATO_NAMESPACE=kato

# HTTP listen address for the REST API.
KATO_LISTEN_ADDR=:8080

# Per-step (and per-iteration) timeout. Go duration syntax.
KATO_STEP_TIMEOUT=30s

# How long Run CRs are kept before garbage collection. 168h = 7 days.
KATO_RUN_TTL=168h

# Maximum concurrent runs; calls beyond this get HTTP 429.
KATO_MAX_CONCURRENT=10

# How often the Run garbage-collection sweep runs.
KATO_GC_INTERVAL=1h

# Max concurrent execution of externally-created (kubectl/GitOps) Run CRs. This
# is separate from KATO_MAX_CONCURRENT, which bounds the REST API path.
KATO_RUN_RECONCILE_CONCURRENCY=2

# A Run stuck in phase=Running longer than this is reaped to phase=Failed by the
# GC sweep. This force-fails ANY run that exceeds it — a healthy long-running one
# as well as one stranded by a controller crash — so keep it comfortably above
# your longest expected run. Go duration syntax.
KATO_RUN_MAX_DURATION=1h

# Timeout for each summary call to the LLM endpoint. Non-streaming endpoints
# (e.g. DashScope coding/reasoning models) only send headers after the whole
# completion is generated, so a slow model needs a generous value. Go duration.
KATO_LLM_TIMEOUT=120s

# Cap on the total evidence (bytes) sent to the LLM per run; 0 = no cap. Bounds a
# runaway prompt (huge ConfigMap/logs) that slows the model and burns tokens. The
# actual prompt size is logged each run ("summarizing ... evidenceBytes=...").
KATO_MAX_EVIDENCE_BYTES=0

# Kubeconfig kato uses to reach the cluster when run OUTSIDE the cluster
# (i.e. `make run`). In-cluster, the pod's ServiceAccount is used instead and
# this is ignored.
KUBECONFIG=${HOME}/.kube/config

# NOTE: the LLM is NOT configured here. It is configured in-cluster via a
# ModelConfig CRD (+ an optional Secret for the API key). See DEVELOPMENT.md.
# With no default ModelConfig, runs still return collected outputs with a
# warning and an empty summary.
