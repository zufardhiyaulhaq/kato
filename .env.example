# Copy to .env and adjust. `make run` loads this file automatically.
# These map 1:1 to internal/config/config.go.

# Namespace where kato stores Run CRs and reads ModelConfig API-key Secrets.
# For local dev, create it first: kubectl create namespace kato
KATO_NAMESPACE=kato

# HTTP listen address for the REST API.
KATO_LISTEN_ADDR=:8080

# Per-step (and per-iteration) timeout. Go duration syntax.
KATO_STEP_TIMEOUT=30s

# How long Run CRs are kept before garbage collection. 168h = 7 days.
KATO_RUN_TTL=168h

# Maximum concurrent runs; calls beyond this get HTTP 429.
KATO_MAX_CONCURRENT=10

# How often the Run garbage-collection sweep runs.
KATO_GC_INTERVAL=1h

# Kubeconfig kato uses to reach the cluster when run OUTSIDE the cluster
# (i.e. `make run`). In-cluster, the pod's ServiceAccount is used instead and
# this is ignored.
KUBECONFIG=${HOME}/.kube/config

# NOTE: the LLM is NOT configured here. It is configured in-cluster via a
# ModelConfig CRD (+ an optional Secret for the API key). See DEVELOPMENT.md.
# With no default ModelConfig, runs still return collected outputs with a
# warning and an empty summary.
